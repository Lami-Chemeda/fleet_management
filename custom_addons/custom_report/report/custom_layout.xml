<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="fleet_management_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="fleet_management_report_temp" model="ir.actions.report">
            <field name="name">Fleet Management Report</field>
            <field name="model">fleet.management</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fleet_management.fleet_management_report_template</field>
            <field name="print_report_name">'Fleet-Management-Report'</field>
            <field name="binding_model_id" ref="fleet_management.model_fleet_management"/>
        </record>

    </data>
</odoo>