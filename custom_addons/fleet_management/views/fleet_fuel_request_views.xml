<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_fuel_request_list" model="ir.ui.view">
        <field name="name">fleet.fuel.request.list</field>
        <field name="model">fleet.fuel.request</field>
        <field name="arch" type="xml">
            <list string="Fuel Requests">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="vehicle_fuel_type" string="Vehicle Fuel Type"/>
                <field name="requested_quantity" string="Qty (L)"/>
                <field name="priority" widget="badge"/>
                <field name="state"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_fuel_request_form" model="ir.ui.view">
        <field name="name">fleet.fuel.request.form</field>
        <field name="model">fleet.fuel.request</field>
        <field name="arch" type="xml">
            <form string="Fuel Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            groups="fleet_management.group_fleet_driver" invisible="state != 'draft'"/>
                    <!-- Department Manager: Authorize button (renamed from "Department Approve") -->
                    <button name="action_dept_authorize" type="object" string="Authorize" class="btn-primary"
                            groups="fleet_management.group_department_manager" invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            groups="fleet_management.group_fleet_manager" invisible="state != 'submitted'"/>
                    <button name="action_issue" type="object" string="Mark Issued" class="btn-primary"
                            groups="fleet_management.group_fleet_manager" invisible="state != 'approved'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            groups="fleet_management.group_fleet_manager" invisible="state != 'issued'"/>
                    <!-- Print Ticket: ONLY visible when state is 'issued' and logged in as fleet manager -->
                    <button name="%(custom_report.action_report_fuel_request)d" type="action" string="Print Ticket"
                            class="btn-secondary"
                            groups="fleet_management.group_fleet_manager"
                            invisible="state != 'issued'"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject"
                            groups="fleet_management.group_fleet_manager"
                            invisible="state not in ['submitted']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset To Draft"
                            groups="fleet_management.group_fleet_manager" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,issued,completed"/>
                </header>
                <sheet>
                    <!-- Hidden helper fields -->
                    <field name="is_manager" invisible="1"/>
                    <field name="is_editable" invisible="1"/>
                    <field name="show_as_label" invisible="1"/>
                    <field name="total_issued_quantity" invisible="1"/>
                    <field name="total_fuel_cost" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <!-- Top info group -->
                    <group>
                        <group>
                            <field name="name"/>
                            <label for="vehicle_id" string="Vehicle"/>
                            <div>
                                <field name="vehicle_id" readonly="1" class="oe_inline"/>
                            </div>
                            <label for="driver_id" string="Driver"/>
                            <div>
                                <field name="driver_id" readonly="1" class="oe_inline"/>
                            </div>
                            <!-- Vehicle Fuel Type hidden: already shown in Product Type column -->
                            <field name="vehicle_fuel_type" invisible="1"/>
                            <label for="request_date" string="Request Date"/>
                            <div>
                                <field name="request_date" readonly="1" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <field name="priority" readonly="not is_editable"/>
                            <!-- Issue Date and Issuer below Priority — fleet manager only -->
                            <field name="issue_date"
                                   groups="fleet_management.group_fleet_manager"
                                   readonly="not is_manager"/>
                            <field name="issuer_id"
                                   groups="fleet_management.group_fleet_manager"
                                   readonly="not is_manager"/>
                        </group>
                    </group>

                    <!-- Reason for Request ABOVE the table -->
                    <group string="Request Details">
                        <field name="reason"
                               placeholder="Please provide the reason for this fuel request..."
                               readonly="not is_editable"/>
                    </group>

                    <!-- Product / Quantity TABLE -->
                    <group string="Product Details">
                        <div colspan="2" style="width:100%;">
                            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                <thead>
                                    <tr style="background-color:#f0f0f0;">
                                        <th style="border:1px solid #ccc; padding:7px 10px; text-align:left; font-weight:bold;">Product Name</th>
                                        <th style="border:1px solid #ccc; padding:7px 10px; text-align:left; font-weight:bold;">Product Type</th>
                                        <th style="border:1px solid #ccc; padding:7px 10px; text-align:left; font-weight:bold;">Unit of Measure</th>
                                        <th style="border:1px solid #ccc; padding:7px 10px; text-align:left; font-weight:bold;">Requested Quantity</th>
                                        <th style="border:1px solid #ccc; padding:7px 10px; text-align:left; font-weight:bold;">Issued Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="border:1px solid #ccc; padding:6px 10px;">
                                            <field name="product_name" readonly="1" nolabel="1"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:6px 10px;">
                                            <field name="product_type" readonly="1" nolabel="1"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:6px 10px;">
                                            <field name="uom_id" readonly="not is_editable" nolabel="1" options="{'no_create': True}"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:6px 10px;">
                                            <field name="requested_quantity" readonly="not is_editable" nolabel="1"/>
                                        </td>
                                        <td style="border:1px solid #ccc; padding:6px 10px;">
                                            <!-- Editable for fleet manager only; readonly for driver -->
                                            <field name="issued_quantity" readonly="not is_manager" nolabel="1"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </group>

                    <!-- Signature / Authorization Section below table -->
         <group>
    <!-- Header and Subtitle -->
    <div style="font-weight:bold;">Approved by</div>
    <div>Fleet Manager</div>
    
    <!-- Blankspace for signing (with structural height) -->
    <div style="height:50px; margin-top:10px;">
        <field name="fleet_approved_by_id" readonly="1" nolabel="1" invisible="not fleet_approved_by_id"/>
    </div>
    
    <!-- Signature Line and Disabled Text -->
    <div style="width:250px; border-top:1px solid #999; padding-top:4px;">
        <span style="color:#999; font-size:11px;">Signature / Name</span>
    </div>
</group>




                    <group>
                        <field name="rejection_reason" readonly="1" invisible="state != 'rejected'"/>
                    </group>

                    <!-- Issues notebook: hidden from all users -->
                    <field name="issue_ids" invisible="1">
                        <list>
                            <field name="issued_quantity"/>
                            <field name="issue_date"/>
                            <field name="issuer_id"/>
                            <field name="cost"/>
                            <field name="currency_id"/>
                            <field name="fuel_request_id" invisible="1"/>
                        </list>
                    </field>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_fuel_request" model="ir.actions.act_window">
        <field name="name">Fuel Requests</field>
        <field name="res_model">fleet.fuel.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>