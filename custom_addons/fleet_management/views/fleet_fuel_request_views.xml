<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_fuel_request_list" model="ir.ui.view">
        <field name="name">fleet.fuel.request.list</field>
        <field name="model">fleet.fuel.request</field>
        <field name="arch" type="xml">
            <list string="Fuel Requests">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="vehicle_fuel_type" string="Vehicle Fuel Type"/>
                <field name="requested_quantity" string="Qty (L)"/>
                <field name="priority" widget="badge"/>
                <field name="state"/>
                <field name="request_date"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_fuel_request_form" model="ir.ui.view">
        <field name="name">fleet.fuel.request.form</field>
        <field name="model">fleet.fuel.request</field>
        <field name="arch" type="xml">
            <form string="Fuel Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" groups="fleet_management.group_fleet_driver" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="fleet_management.group_fleet_manager" invisible="state != 'submitted'"/>
                    <button name="action_issue" type="object" string="Mark Issued" class="btn-primary" groups="fleet_management.group_fleet_manager" invisible="state != 'approved'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" groups="fleet_management.group_fleet_manager" invisible="state != 'issued'"/>
                    <button name="%(custom_report.action_report_fuel_request)d" type="action" string="Print Ticket" class="btn-secondary" invisible="state in ['draft', 'submitted', 'rejected']"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject" 
                            groups="fleet_management.group_fleet_manager" 
                            invisible="state not in ['submitted']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset To Draft" groups="fleet_management.group_fleet_manager" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,issued,completed"/>
                </header>
                <sheet>
                    <field name="is_manager" invisible="1"/>
                    <field name="is_editable" invisible="1"/>
                    <field name="show_as_label" invisible="1"/>
                    
                    <group>
                        <group>
                            <field name="name"/>
                            
                            <!-- Vehicle - Locked and visible -->
                            <label for="vehicle_id" string="Vehicle"/>
                            <div>
                                <field name="vehicle_id" readonly="1" class="oe_inline"/>
                            </div>
                            
                            <!-- Driver - Locked and visible -->
                            <label for="driver_id" string="Driver"/>
                            <div>
                                <field name="driver_id" readonly="1" class="oe_inline"/>
                            </div>
                            
                            <!-- Vehicle Fuel Type - Display from vehicle registration -->
                            <label for="vehicle_fuel_type" string="Vehicle Fuel Type"/>
                            <div>
                                <field name="vehicle_fuel_type" readonly="1" class="oe_inline"/>
                            </div>
                            
                            <!-- Request Date -->
                            <label for="request_date" string="Request Date"/>
                            <div>
                                <field name="request_date" readonly="1" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <field name="priority" readonly="not is_editable"/>
                            <field name="requested_quantity" string="Requested Quantity (Liters)" readonly="not is_editable"/>
                            <field name="total_issued_quantity" invisible="1"/>
                            <field name="total_fuel_cost" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group string="Request Details">
                        <field name="reason" 
                               placeholder="Please provide the reason for this fuel request..."
                               readonly="not is_editable"
                               colspan="2"/>
                    </group>
                    
                    <group>
                        <field name="rejection_reason" readonly="1" invisible="state != 'rejected'"/>
                    </group>
                    
                    <notebook>
                        <!-- Page 1: Editable Issues (for draft, submitted, approved states) -->
                        <page string="Issues" groups="fleet_management.group_fleet_manager" 
                              invisible="state in ['issued', 'completed']">
                            <field name="issue_ids" editable="bottom">
                                <list editable="bottom">
                                    <field name="issued_quantity"/>
                                    <field name="issue_date"/>
                                    <field name="issuer_id"/>
                                    <field name="cost"/>
                                    <field name="currency_id"/>
                                    <field name="fuel_request_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Page 2: Readonly Issues (for issued, completed states) -->
                        <page string="Issues" groups="fleet_management.group_fleet_manager" 
                              invisible="state not in ['issued', 'completed']">
                            <field name="issue_ids" readonly="1">
                                <list>
                                    <field name="issued_quantity"/>
                                    <field name="issue_date"/>
                                    <field name="issuer_id"/>
                                    <field name="cost"/>
                                    <field name="currency_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_fuel_request" model="ir.actions.act_window">
        <field name="name">Fuel Requests</field>
        <field name="res_model">fleet.fuel.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>