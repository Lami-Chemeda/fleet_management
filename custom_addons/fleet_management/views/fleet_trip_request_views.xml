<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_trip_request_list" model="ir.ui.view">
        <field name="name">fleet.trip.request.list</field>
        <field name="model">fleet.trip.request</field>
        <field name="arch" type="xml">
            <list string="Vehicle Requests" decoration-info="state in ('submitted', 'department_approved', 'fleet_approved')" decoration-warning="state == 'allocated'" decoration-success="state == 'completed'" decoration-danger="state in ('rejected', 'cancelled')">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="destination"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_trip_request_form" model="ir.ui.view">
        <field name="name">fleet.trip.request.form</field>
        <field name="model">fleet.trip.request</field>
        <field name="arch" type="xml">
            <form string="Vehicle Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" groups="fleet_management.group_fleet_user" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="fleet_management.group_fleet_user,fleet_management.group_department_manager" invisible="state != 'draft'"/>
                    <button name="action_department_approve" type="object" string="Department Approve" class="btn-primary" groups="fleet_management.group_department_manager" invisible="state != 'submitted'"/>
                    <button name="action_fleet_approve" type="object" string="Fleet Approve" class="btn-primary" groups="fleet_management.group_fleet_manager" invisible="state != 'department_approved'"/>
                    <button name="action_allocate" type="object" string="Mark Allocated" class="btn-primary" groups="fleet_management.group_fleet_manager" invisible="state != 'fleet_approved'"/>
                    <button name="action_finish_trip" type="object" string="Finish Trip" class="btn-primary" groups="fleet_management.group_fleet_user,fleet_management.group_fleet_driver" invisible="not can_execute_current_user"/>
                    <button name="action_open_reject_wizard" type="object" string="Reject" groups="fleet_management.group_department_manager,fleet_management.group_fleet_manager" invisible="not show_reject_button"/>
                    <button name="action_reset_to_draft" type="object" string="Reset To Draft" groups="fleet_management.group_fleet_manager" invisible="state not in ['cancelled', 'rejected']"/>
                    <field name="can_execute_current_user" invisible="1"/>
                    <field name="can_edit_requester" invisible="1"/>
                    <field name="can_edit_attachments" invisible="1"/>
                    <field name="is_editable" invisible="1"/>
                    <field name="show_reject_button" invisible="1"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,department_approved,fleet_approved,allocated,completed"/>
                </header>
                <sheet>
                    <!-- Rejection Details Display Section -->
                    <group name="rejection_details" invisible="state != 'rejected'">
                        <field name="rejection_details_display" widget="html" colspan="2"/>
                    </group>
                    <group>
                        <group>
                            <field name="name" readonly="not is_editable"/>
                            <field name="requester_id" readonly="not can_edit_requester"/>
                            <field name="department_id"/>
                            <field name="start_place" readonly="not is_editable"/>
                            <field name="destination" readonly="not is_editable"/>
                            <field name="number_of_people" readonly="not is_editable"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="1"/>
                            <field name="start_date" readonly="not is_editable"/>
                            <field name="end_date" readonly="not is_editable"/>
                            <field name="requester_executed" readonly="1"/>
                            <field name="driver_executed" readonly="1"/>
                            
                            <!-- Hidden Filename tracking field -->
                            <field name="attachment_filename" invisible="1"/>
                            <!-- File attachment upload control - only editable in draft state -->
                            <label for="attachment_file" string="Attachment / Document"/>
                            <div class="o_row">
                                <field name="attachment_file" filename="attachment_filename" readonly="not can_edit_attachments"/>
                                <button name="action_preview_attachment" type="object" string="View Attachment" icon="fa-eye" class="btn-secondary" invisible="not attachment_file"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="purpose" readonly="not is_editable"/>
                        <field name="rejection_reason" readonly="1" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Assignments" groups="fleet_management.group_fleet_manager">
                            <field name="assignment_ids" readonly="state in ['allocated', 'completed', 'cancelled', 'rejected']">
                                <list editable="bottom">
                                    <field name="vehicle_driver_id" column_invisible="1"/>
                                    <field name="vehicle_id" domain="[('fleet_status', '=', 'available'), ('current_driver_id', '!=', False), ('has_active_request', '=', False)]" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="driver_id" readonly="1" force_save="1" domain="[('id', '=', vehicle_driver_id)]"/>
                                    <field name="assignment_date"/>
                                    <field name="return_date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_trip_request" model="ir.actions.act_window">
        <field name="name">Vehicle Requests</field>
        <field name="res_model">fleet.trip.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>