<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_fleet_drivers" model="ir.actions.act_window">
            <field name="name">Drivers</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('is_fleet_driver', '=', True)]</field>
            <field name="context">{'default_is_fleet_driver': True}</field>
        </record>

        <record id="view_employee_form_inherit_fleet_driver_details"
                model="ir.ui.view">

            <field name="name">
                hr.employee.form.inherit.fleet.driver.details
            </field>

            <field name="model">hr.employee</field>

            <field name="inherit_id"
                   ref="hr.view_employee_form"/>

            <field name="arch" type="xml">

                <xpath expr="//page[@name='hr_settings']" position="inside">
                    <!-- Fleet management settings have been moved to the Users settings page -->
                </xpath>

            </field>

        </record>

        <record id="view_users_form_inherit_fleet_role" model="ir.ui.view">
            <field name="name">res.users.form.inherit.fleet.role</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Fleet Management" name="fleet_management">
                        <group name="fleet_role_group" string="Fleet Management Role">
                            <field name="fleet_role" string="Fleet Role"/>
                            <field name="is_fleet_user" string="Fleet User"/>
                            <field name="is_fleet_driver" string="Is a Driver"/>
                            <field name="is_fleet_manager" string="Fleet Manager"/>
                            <field name="is_department_manager" string="Department Manager"/>
                        </group>
                        <group name="driver_license_group" string="Driver License Details"
                               invisible="fleet_role != 'driver' and not is_fleet_driver">
                            <field name="driver_license_number"
                                   required="fleet_role == 'driver' or is_fleet_driver"/>
                            <field name="driver_license_category"
                                   required="fleet_role == 'driver' or is_fleet_driver"/>
                            <field name="driver_license_issue_date"
                                   required="fleet_role == 'driver' or is_fleet_driver"/>
                            <field name="driver_license_expiry_date"
                                   required="fleet_role == 'driver' or is_fleet_driver"/>
                            <field name="driver_license_suspended"
                                   required="fleet_role == 'driver' or is_fleet_driver"/>
                            <field name="driver_license_image"
                                   widget="image"
                                   options="{'size':[90,90]}"
                                   required="fleet_role == 'driver' or is_fleet_driver"/>
                            <field name="driver_license_status" readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>