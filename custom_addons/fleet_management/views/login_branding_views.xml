<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout_fleet_branding" inherit_id="web.login_layout" name="Fleet Login Branding">
        
        <!-- 1. Custom Welcome Title at the top -->
        <xpath expr="//div[hasclass('container')]" position="before">
            <div style="text-align:center; margin:20px 0;">
                <h2 style="color:#007bff; font-weight:bold;">
                    🚗🚚 Welcome to Fleet Management System for OTech 🚚🚗
                </h2>
            </div>
        </xpath>

        <!-- 2. Replaces the default logo with your custom vehicle image -->
        <xpath expr="//div[hasclass('card-body')]//div[hasclass('text-center')][img]" position="replace">
            <div class="text-center mb-4">
                <img src="/fleet_management/static/src/img/logo.png" 
                     alt="Fleet Management Logo" 
                     style="max-height: 150px; max-width: 100%; object-fit: contain; margin: 0 auto; display: block;"/>
            </div>
        </xpath>

        <!-- 3. Hides BOTH 'Powered by Odoo' AND 'Manage Databases' footer links entirely -->
        <xpath expr="//div[hasclass('card-body')]//div[contains(@class, 'text-center') and contains(@class, 'small')]" position="replace">
            <!-- Left completely blank to eliminate the footer links row entirely -->
        </xpath>

    </template>
</odoo>
