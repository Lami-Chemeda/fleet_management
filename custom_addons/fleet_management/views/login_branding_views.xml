<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="login_layout_fleet_branding"
                  inherit_id="web.login_layout"
                  name="Fleet Login Branding">

            <!-- Welcome Title -->
            <xpath expr="//div[hasclass('container')]" position="before">
                <div style="text-align:center; margin:20px 0;">
                    <h2 style="color:#007bff; font-weight:bold;">
                        Welcome to Fleet Management System for OTech
                    </h2>
                </div>
            </xpath>

            <!-- Replace Default Logo -->
            <xpath expr="//div[hasclass('card-body')]//div[hasclass('text-center')][img]"
                   position="replace">
                <div class="text-center mb-4">
                    <img src="/fleet_management/static/src/img/logo.png"
                         alt="Fleet Management Logo"
                         style="max-height:150px;
                                max-width:100%;
                                object-fit:contain;
                                margin:0 auto;
                                display:block;"/>
                </div>
            </xpath>

            <!-- Hide Footer Links -->
            <xpath expr="//div[hasclass('card-body')]//div[hasclass('small')]"
                   position="replace">
            </xpath>

        </template>

    </data>
</odoo>