<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Document Expiry Check -->
        <record id="ir_cron_check_document_expiry" model="ir.cron">
            <field name="name">Fleet: Check Document Expiry</field>
            <field name="model_id" ref="model_fleet_vehicle_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_document_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job for Tyre Replacement Check -->
        <record id="ir_cron_check_tyre_replacement" model="ir.cron">
            <field name="name">Fleet: Check Tyre Replacement</field>
            <field name="model_id" ref="model_fleet_vehicle_tyre"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_tyre_replacement()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job for Maintenance Due Check -->
        <record id="ir_cron_check_maintenance_due" model="ir.cron">
            <field name="name">Fleet: Check Maintenance Due</field>
            <field name="model_id" ref="model_fleet_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_maintenance_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron Job for Pending Trip Requests -->
        <record id="ir_cron_check_pending_trips" model="ir.cron">
            <field name="name">Fleet: Check Pending Trips</field>
            <field name="model_id" ref="model_fleet_trip_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_pending_trips()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>

</odoo>
