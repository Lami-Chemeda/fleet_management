<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server Action to open the dashboard (since it's a TransientModel we need to create it on the fly) -->
    <record id="action_fleet_backend_dashboard" model="ir.actions.server">
        <field name="name">Executive Dashboard</field>
        <field name="model_id" ref="fleet_management.model_fleet_backend_dashboard"/>
        <field name="state">code</field>
        <field name="code">
# Create the transient record
record = env['fleet.backend.dashboard'].create({})
action = {
    'type': 'ir.actions.act_window',
    'name': 'Fleet Executive Dashboard',
    'res_model': 'fleet.backend.dashboard',
    'res_id': record.id,
    'view_mode': 'form',
    'target': 'inline',
}
        </field>
    </record>

    <record id="view_fleet_backend_dashboard_form" model="ir.ui.view">
        <field name="name">fleet.backend.dashboard.form</field>
        <field name="model">fleet.backend.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <style>
                    /* Custom Dashboard CSS */
                    .o_form_view .o_form_sheet_bg {
                        background: #f1f5f9 !important;
                    }
                    .fleet_dashboard_container {
                        font-family: 'Inter', sans-serif;
                        padding: 20px;
                        background: #f1f5f9;
                    }
                    .dash_header {
                        background: linear-gradient(135deg, #4f46e5, #0ea5e9);
                        padding: 30px;
                        border-radius: 20px;
                        color: white;
                        margin-bottom: 25px;
                        box-shadow: 0 10px 25px rgba(14, 165, 233, 0.3);
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }
                    .dash_header h1 {
                        font-size: 2.2rem;
                        font-weight: 800;
                        margin: 0;
                        letter-spacing: -1px;
                    }
                    .dash_header p {
                        font-size: 1.1rem;
                        opacity: 0.9;
                        margin-top: 5px;
                    }
                    .kpi_cards {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                        gap: 20px;
                        margin-bottom: 30px;
                    }
                    .kpi_card {
                        background: white;
                        border-radius: 15px;
                        padding: 20px;
                        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
                        border: 1px solid rgba(0,0,0,0.05);
                        transition: transform 0.3s ease;
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                    }
                    .kpi_card:hover {
                        transform: translateY(-5px);
                        box-shadow: 0 15px 30px rgba(0,0,0,0.1);
                    }
                    .kpi_icon {
                        font-size: 2rem;
                        margin-bottom: 15px;
                    }
                    .kpi_title {
                        color: #64748b;
                        font-weight: 600;
                        text-transform: uppercase;
                        font-size: 0.85rem;
                        letter-spacing: 1px;
                    }
                    .kpi_value {
                        font-size: 2.5rem;
                        font-weight: 800;
                        color: #0f172a;
                        margin-top: 5px;
                    }
                    .action_grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                        gap: 20px;
                    }
                    .action_btn {
                        background: white;
                        border-radius: 15px;
                        padding: 25px;
                        text-align: center;
                        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
                        border: 1px solid rgba(0,0,0,0.05);
                        transition: all 0.3s;
                    }
                    .action_btn:hover {
                        border-color: #4f46e5;
                        background: #f8fafc;
                        cursor: pointer;
                    }
                    .action_btn i {
                        font-size: 3rem;
                        color: #4f46e5;
                        margin-bottom: 15px;
                    }
                    .action_btn h3 {
                        font-size: 1.3rem;
                        color: #1e293b;
                        font-weight: 700;
                        margin: 0;
                    }
                </style>
                <sheet>
                    <!-- Silent fields to load the KPI values -->
                    <field name="vehicle_count" invisible="1"/>
                    <field name="trip_count" invisible="1"/>
                    <field name="incident_count" invisible="1"/>
                    <field name="maintenance_count" invisible="1"/>
                    
                    <div class="fleet_dashboard_container">
                        <!-- Header -->
                        <div class="dash_header">
                            <div>
                                <h1>Welcome to Fleet Management Pro</h1>
                                <p>Your operational command center.</p>
                            </div>
                            <div>
                                <i class="fa fa-truck" title="Fleet Dashboard Icon" style="font-size: 4rem; opacity: 0.5;"></i>
                            </div>
                        </div>

                        <!-- KPIs -->
                        <div class="kpi_cards">
                            <div class="kpi_card">
                                <div class="kpi_icon" style="color: #4f46e5;"><i class="fa fa-car" title="Active Vehicles"></i></div>
                                <div class="kpi_title">Active Vehicles</div>
                                <div class="kpi_value"><field name="vehicle_count" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="kpi_card">
                                <div class="kpi_icon" style="color: #10b981;"><i class="fa fa-road" title="Total Trips"></i></div>
                                <div class="kpi_title">Total Trips</div>
                                <div class="kpi_value"><field name="trip_count" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="kpi_card">
                                <div class="kpi_icon" style="color: #f59e0b;"><i class="fa fa-wrench" title="Maintenance Jobs"></i></div>
                                <div class="kpi_title">Maintenance Jobs</div>
                                <div class="kpi_value"><field name="maintenance_count" readonly="1" nolabel="1"/></div>
                            </div>
                            <div class="kpi_card">
                                <div class="kpi_icon" style="color: #ef4444;"><i class="fa fa-exclamation-triangle" title="Incidents"></i></div>
                                <div class="kpi_title">Incidents</div>
                                <div class="kpi_value"><field name="incident_count" readonly="1" nolabel="1"/></div>
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <h2 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 15px; margin-top: 40px;">Quick Actions</h2>
                        <div class="action_grid">
                            <button name="action_open_vehicles" type="object" class="btn btn-link action_btn">
                                <i class="fa fa-truck" title="Manage Vehicles"></i>
                                <h3>Manage Vehicles</h3>
                            </button>
                            <button name="action_open_trips" type="object" class="btn btn-link action_btn">
                                <i class="fa fa-map-marker" title="Dispatch Trips"></i>
                                <h3>Dispatch Trips</h3>
                            </button>
                            <button name="action_open_maintenance" type="object" class="btn btn-link action_btn">
                                <i class="fa fa-cogs" title="Schedule Service"></i>
                                <h3>Schedule Service</h3>
                            </button>
                            <button name="action_open_incidents" type="object" class="btn btn-link action_btn">
                                <i class="fa fa-warning" title="Log Incident"></i>
                                <h3>Log Incident</h3>
                            </button>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
