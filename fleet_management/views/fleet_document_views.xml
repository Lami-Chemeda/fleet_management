<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_document_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.document.tree</field>
        <field name="model">fleet.vehicle.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'expired'" decoration-warning="status == 'expiring_soon'">
                <field name="name"/>
                <field name="document_type"/>
                <field name="vehicle_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="status" widget="badge" decoration-success="status == 'valid'" decoration-warning="status == 'expiring_soon'" decoration-danger="status == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_document_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.document.form</field>
        <field name="model">fleet.vehicle.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. REG-2024-001"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment" filename="attachment_name"/>
                        <field name="attachment_name" invisible="1"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_vehicle_document" model="ir.actions.act_window">
        <field name="name">Vehicle Documents</field>
        <field name="res_model">fleet.vehicle.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
