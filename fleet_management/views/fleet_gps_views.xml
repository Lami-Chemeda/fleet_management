<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_gps_log_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.gps.log.list</field>
        <field name="model">fleet.vehicle.gps.log</field>
        <field name="arch" type="xml">
            <list string="GPS Logs" default_order="timestamp desc" decoration-danger="geofence_alert == True">
                <field name="timestamp"/>
                <field name="vehicle_id" widget="many2one_avatar"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="speed"/>
                <field name="source"/>
                <field name="geofence_alert" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_gps_log_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.gps.log.form</field>
        <field name="model">fleet.vehicle.gps.log</field>
        <field name="arch" type="xml">
            <form string="GPS Log">
                <sheet>
                    <widget name="web_ribbon" title="Alert" bg_color="text-bg-danger" invisible="geofence_alert == False"/>
                    <group>
                        <group>
                            <field name="vehicle_id" widget="many2one_avatar"/>
                            <field name="timestamp"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="speed"/>
                            <field name="geofence_alert"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_vehicle_gps_log" model="ir.actions.act_window">
        <field name="name">GPS Logs</field>
        <field name="res_model">fleet.vehicle.gps.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No GPS Logs found.
            </p>
            <p>
                Configure your vehicle trackers to send location data to Odoo to see historical routes and speeds.
            </p>
        </field>
    </record>

</odoo>
