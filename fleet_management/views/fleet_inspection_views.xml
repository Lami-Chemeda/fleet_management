<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_inspection_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.inspection.tree</field>
        <field name="model">fleet.vehicle.inspection</field>
        <field name="arch" type="xml">
            <list decoration-success="overall_result == 'pass'" decoration-danger="overall_result == 'fail'">
                <field name="name"/>
                <field name="inspection_type"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="date"/>
                <field name="overall_result" widget="badge" decoration-success="overall_result == 'pass'" decoration-danger="overall_result == 'fail'"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_inspection_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.inspection.form</field>
        <field name="model">fleet.vehicle.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="overall_result" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="inspection_type"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="trip_id"/>
                            <field name="maintenance_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="item_name"/>
                                    <field name="condition"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_vehicle_inspection" model="ir.actions.act_window">
        <field name="name">Vehicle Inspections</field>
        <field name="res_model">fleet.vehicle.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
