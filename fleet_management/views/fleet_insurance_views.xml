<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_insurance_tree" model="ir.ui.view">
        <field name="name">fleet.vehicle.insurance.tree</field>
        <field name="model">fleet.vehicle.insurance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="insurer_id"/>
                <field name="coverage_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_insurance_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.insurance.form</field>
        <field name="model">fleet.vehicle.insurance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Policy Number"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="insurer_id"/>
                            <field name="coverage_type"/>
                        </group>
                        <group>
                            <field name="premium_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Claims">
                            <field name="claim_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="claim_date"/>
                                    <field name="claim_amount"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_vehicle_insurance" model="ir.actions.act_window">
        <field name="name">Insurances</field>
        <field name="res_model">fleet.vehicle.insurance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fleet_insurance_claim" model="ir.actions.act_window">
        <field name="name">Insurance Claims</field>
        <field name="res_model">fleet.insurance.claim</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
