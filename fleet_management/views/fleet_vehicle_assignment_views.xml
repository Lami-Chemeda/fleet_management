<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_assignment_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.assignment.list</field>
        <field name="model">fleet.vehicle.assignment</field>
        <field name="arch" type="xml">
            <list string="Vehicle Assignments" create="0" edit="0" delete="0">
                <field name="trip_request_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="assignment_date"/>
                <field name="return_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_assignment_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.assignment.form</field>
        <field name="model">fleet.vehicle.assignment</field>
        <field name="arch" type="xml">
            <form string="Vehicle Assignment" create="0" edit="0" delete="0">
                <header>
                    <button name="action_assign_vehicle" type="object" string="Assign Vehicle" class="btn-primary" groups="fleet_management.group_fleet_manager" invisible="status != 'draft'"/>
                    <button name="action_return_vehicle" type="object" string="Return Vehicle" class="btn-primary" groups="fleet_management.group_fleet_driver,fleet_management.group_fleet_manager" invisible="status != 'assigned'"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="fleet_management.group_fleet_manager" invisible="status in ['returned', 'cancelled']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,assigned,returned,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="trip_request_id" readonly="1"/>
                            <field name="vehicle_driver_id" invisible="1"/>
                            <field name="number_of_people_display" invisible="1"/>
                            <field name="vehicle_id" readonly="1" domain="[('fleet_status', '=', 'available'), ('current_driver_id', '!=', False), ('has_active_request', '=', False), ('seat_count', '&gt;=', number_of_people_display)]" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="driver_id" readonly="1" force_save="1" domain="[('id', '=', vehicle_driver_id)]"/>
                        </group>
                        <group>
                            <field name="assignment_date" readonly="1"/>
                            <field name="return_date" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_vehicle_assignment_list_fleet_manager_no_create" model="ir.ui.view">
        <field name="name">fleet.vehicle.assignment.list.fleet.manager.no.create</field>
        <field name="model">fleet.vehicle.assignment</field>
        <field name="inherit_id" ref="view_fleet_vehicle_assignment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes" groups="fleet_management.group_fleet_manager">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_assignment_form_fleet_manager_no_create" model="ir.ui.view">
        <field name="name">fleet.vehicle.assignment.form.fleet.manager.no.create</field>
        <field name="model">fleet.vehicle.assignment</field>
        <field name="inherit_id" ref="view_fleet_vehicle_assignment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes" groups="fleet_management.group_fleet_manager">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_fleet_vehicle_assignment" model="ir.actions.act_window">
        <field name="name">Vehicle Assignments</field>
        <field name="res_model">fleet.vehicle.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>