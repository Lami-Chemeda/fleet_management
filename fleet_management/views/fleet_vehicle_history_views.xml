<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_history_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.history.list</field>
        <field name="model">fleet.vehicle.history</field>
        <field name="arch" type="xml">
            <list string="Vehicle History">
                <field name="event_date"/>
                <field name="event_type"/>
                <field name="vehicle_name"/>
                <field name="license_plate"/>
                <field name="model_id"/>
                <field name="chassis_number"/>
                <field name="engine_number"/>
                <field name="ownership_type"/>
                <field name="registration_date"/>
                <field name="fleet_status"/>
                <field name="driver_id"/>
                <field name="odometer"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_history_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.history.form</field>
        <field name="model">fleet.vehicle.history</field>
        <field name="arch" type="xml">
            <form string="Vehicle History">
                <sheet>
                    <group>
                        <group string="Event Information">
                            <field name="vehicle_id"/>
                            <field name="event_type"/>
                            <field name="event_date"/>
                            <field name="driver_id"/>
                            <field name="odometer"/>
                        </group>
                        <group string="Vehicle Information">
                            <field name="vehicle_name"/>
                            <field name="license_plate"/>
                            <field name="model_id"/>
                            <field name="fleet_status"/>
                        </group>
                    </group>
                    <group>
                        <group string="Registration Details">
                            <field name="chassis_number"/>
                            <field name="engine_number"/>
                            <field name="ownership_type"/>
                            <field name="registration_certificate_number"/>
                            <field name="registration_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_fleet_vehicle_history_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.history.search</field>
        <field name="model">fleet.vehicle.history</field>
        <field name="arch" type="xml">
            <search string="Vehicle History">
                <field name="vehicle_id"/>
                <field name="license_plate"/>
                <field name="event_type"/>
                <field name="driver_id"/>
                <filter name="registered" string="Registered" domain="[('event_type', '=', 'registered')]"/>
                <filter name="assigned" string="Assigned" domain="[('event_type', '=', 'assigned')]"/>
                <filter name="maintenance" string="Maintenance" domain="[('event_type', 'in', ['maintenance_started', 'maintenance_completed'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_event_type" string="Event Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fleet_vehicle_history" model="ir.actions.act_window">
        <field name="name">Vehicle History</field>
        <field name="res_model">fleet.vehicle.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fleet_vehicle_history_search"/>
    </record>
</odoo>
