<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_custom_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.custom.list</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" multi_edit="1" sample="1">
                <field name="name" string="Vehicle Name"/>
                <field name="license_plate"/>
                <field name="model_id"/>
                <field name="vehicle_type"/>
                <field name="ownership_type" widget="badge" decoration-info="ownership_type == 'owned'" decoration-warning="ownership_type == 'leased'"/>
                <field name="fleet_status" widget="badge" decoration-success="fleet_status == 'active'" decoration-danger="fleet_status == 'inactive'" decoration-warning="fleet_status == 'maintenance'"/>
                <field name="current_driver_id" widget="many2one_avatar"/>
                <field name="current_odometer" string="Odometer"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_custom_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.custom.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <field name="fleet_status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_fleet_vehicle_gps_log)d" type="action" class="oe_stat_button" icon="fa-map-marker" context="{'search_default_vehicle_id': id, 'default_vehicle_id': id}">
                            <field name="gps_log_count" widget="statinfo" string="GPS Logs"/>
                        </button>
                        <button name="%(action_fleet_vehicle_document)d" type="action" class="oe_stat_button" icon="fa-file-text" context="{'default_vehicle_id': id}">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="%(action_fleet_vehicle_insurance)d" type="action" class="oe_stat_button" icon="fa-shield" context="{'default_vehicle_id': id}">
                            <field name="insurance_count" widget="statinfo" string="Insurance"/>
                        </button>
                        <button name="%(action_fleet_incident)d" type="action" class="oe_stat_button" icon="fa-exclamation-circle text-danger" context="{'default_vehicle_id': id}">
                            <field name="incident_count" widget="statinfo" string="Incidents"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Active" bg_color="text-bg-success" invisible="fleet_status != 'active'"/>
                    <widget name="web_ribbon" title="Maintenance" bg_color="text-bg-warning" invisible="fleet_status != 'maintenance'"/>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Ford Transit Van"/>
                        </h1>
                        <label for="license_plate" class="oe_edit_only"/>
                        <h2>
                            <field name="license_plate" placeholder="e.g. AB-123-CD"/>
                        </h2>
                    </div>

                    <group>
                        <group string="Basic Information">
                            <field name="model_id"/>
                            <field name="vehicle_type"/>
                            <field name="custom_fuel_type_id"/>
                            <field name="ownership_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="special_case"/>
                        </group>
                        <group string="Operation Details">
                            <field name="current_driver_id" domain="[('is_fleet_driver', '=', True), ('current_vehicle_ids', '=', False)]" widget="many2one_avatar" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="current_odometer"/>
                            <field name="seat_count"/>
                        </group>
                    </group>
                    <group string="Registration &amp; Specs">
                        <group>
                            <field name="vin_sn"/>
                            <field name="engine_number"/>
                        </group>
                        <group>
                            <field name="registration_certificate_number"/>
                            <field name="registration_date"/>
                            <field name="acquisition_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_management_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('fleet.fleet_vehicle_view_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fleet_vehicle_custom_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_fleet_vehicle_custom_form')})
        ]"/>
    </record>
</odoo>
