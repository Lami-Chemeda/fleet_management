<?xml version="1.0" encoding="UTF-8" ?>
<!-- Template Theme: customize this file for your theme. -->

<templates xml:space="preserve">

    <!-- Inherit and extend the main WebClient template -->
	<t 
		t-name="pine_backend_theme_appsbar.WebClient"
		t-inherit="web.WebClient" 
		t-inherit-mode="extension" 
	>
        <!-- Inject the custom AppsBar component immediately after the NavBar -->
	    <xpath expr="//NavBar" position="after">
	    	<AppsBar/>
	    </xpath>
	</t>
	
</templates>