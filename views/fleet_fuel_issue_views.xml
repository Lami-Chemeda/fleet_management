<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_fuel_issue_list" model="ir.ui.view">
        <field name="name">fleet.fuel.issue.list</field>
        <field name="model">fleet.fuel.issue</field>
        <field name="arch" type="xml">
            <list string="Fuel Issues">
                <field name="fuel_request_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="issued_quantity"/>
                <field name="issue_date"/>
                <field name="issuer_id"/>
                <field name="cost"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_fuel_issue_form" model="ir.ui.view">
        <field name="name">fleet.fuel.issue.form</field>
        <field name="model">fleet.fuel.issue</field>
        <field name="arch" type="xml">
            <form string="Fuel Issue">
                <header>
                    <button name="action_confirm_issue" type="object" string="Confirm Issue" class="btn-primary" groups="fleet_management.group_fleet_manager"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="fuel_request_id"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="issued_quantity"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="issuer_id"/>
                            <field name="cost"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_fuel_issue" model="ir.actions.act_window">
        <field name="name">Fuel Issues</field>
        <field name="res_model">fleet.fuel.issue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
