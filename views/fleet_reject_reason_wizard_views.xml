<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_reject_reason_wizard_form" model="ir.ui.view">
        <field name="name">fleet.reject.reason.wizard.form</field>
        <field name="model">fleet.reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Request">
                <group>
                    <field name="request_model" invisible="1"/>
                    <field name="request_id" invisible="1"/>
                    <field name="reason" placeholder="Enter the reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Reject" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
