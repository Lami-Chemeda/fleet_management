<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_vehicle_custom_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.custom.list</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="chassis_number"/>
                <field name="model_id"/>
                <field name="vehicle_type"/>
                <field name="ownership_type"/>
                <field name="fleet_status"/>
                <field name="current_driver_id"/>
                <field name="current_odometer"/>
            </list>
        </field>
    </record>

    <record id="view_fleet_vehicle_custom_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.custom.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <group>
                        <group string="Basic Information">
                            <field name="name"/>
                            <field name="license_plate"/>
                            <field name="model_id"/>
                            <field name="vehicle_type"/>
                            <field name="fuel_type"/>
                            <field name="ownership_type"/>
                            <field name="fleet_status"/>
                            <field name="special_case"/>
                        </group>
                        <group string="Registration">
                            <field name="vin_sn"/>
                            <field name="chassis_number"/>
                            <field name="engine_number"/>
                            <field name="registration_certificate_number"/>
                            <field name="registration_date"/>
                            <field name="acquisition_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Operation">
                            <field name="current_driver_id" domain="[('is_fleet_driver', '=', True), ('current_vehicle_ids', '=', False)]" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="current_odometer"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fleet_management_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fleet_vehicle_custom_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_fleet_vehicle_custom_form')})
        ]"/>
    </record>
</odoo>
