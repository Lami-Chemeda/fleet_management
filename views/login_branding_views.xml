<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="login_layout_fleet_branding"
              inherit_id="web.login_layout"
              name="Fleet Login Branding">

        <!-- Insert banner at the top of the login page -->
        <xpath expr="//div[hasclass('container')]" position="before">

            <style>
                .fleet_welcome_banner {
                    width: 100%;
                    overflow: hidden;
                    border-radius: 0;
                    margin-bottom: 20px;
                    padding: 15px 0;
                    background: linear-gradient(-45deg, #007bff, #28a745, #ffc107, #dc3545);
                    background-size: 400% 400%;
                    animation: gradientBG 8s ease infinite;
                    box-shadow: 0 6px 15px rgba(0,0,0,0.3);
                }

                .fleet_marquee {
                    display: inline-block;
                    white-space: nowrap;
                    color: #ffffff;
                    font-size: 32px;
                    font-weight: bold;
                    font-family: Arial, Helvetica, sans-serif;
                    text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
                    animation: marqueeMove 12s linear infinite;
                }

                @keyframes marqueeMove {
                    0% {
                        transform: translateX(100%);
                    }
                    100% {
                        transform: translateX(-100%);
                    }
                }

                @keyframes gradientBG {
                    0% {
                        background-position: 0% 50%;
                    }
                    50% {
                        background-position: 100% 50%;
                    }
                    100% {
                        background-position: 0% 50%;
                    }
                }
            </style>

            <div class="fleet_welcome_banner">
                <div class="fleet_marquee">
                    🚗🚚 Welcome to Fleet Management System 🚚🚗
                </div>
            </div>

        </xpath>

    </template>

</odoo>
